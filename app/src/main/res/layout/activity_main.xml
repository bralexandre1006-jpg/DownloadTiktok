<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05050A">

    <!-- Fond : orbes colorées floues -->
    <FrameLayout
        android:id="@+id/orbs"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:id="@+id/orb1"
            android:layout_width="460dp"
            android:layout_height="460dp"
            android:layout_gravity="top|start"
            android:layout_marginStart="-180dp"
            android:layout_marginTop="-120dp"
            android:background="@drawable/bg_orb_pink" />

        <View
            android:id="@+id/orb2"
            android:layout_width="440dp"
            android:layout_height="440dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="-200dp"
            android:background="@drawable/bg_orb_cyan" />

        <View
            android:id="@+id/orb3"
            android:layout_width="480dp"
            android:layout_height="480dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="-160dp"
            android:layout_marginBottom="-160dp"
            android:background="@drawable/bg_orb_violet" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="16dp"
            android:paddingTop="56dp"
            android:paddingRight="16dp"
            android:paddingBottom="130dp">

            <!-- En-tête -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="6dp"
                android:paddingBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02"
                    android:text="TikSave"
                    android:textColor="#FFFFFF"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="TikTok · Instagram · X"
                    android:textColor="#99FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Compteurs -->
            <LinearLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="bottom">

                    <TextView
                        android:id="@+id/total"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.04"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="76sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_glass_chip"
                        android:gravity="center_vertical"
                        android:paddingLeft="12dp"
                        android:paddingTop="6dp"
                        android:paddingRight="12dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/today"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="aujourd'hui"
                            android:textColor="#B3FFFFFF"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="téléchargements"
                    android:textColor="#99FFFFFF"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="20dp"
                        android:layout_height="20dp">

                        <View
                            android:id="@+id/statusPulse"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_dot" />

                        <View
                            android:id="@+id/statusDot"
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_dot" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/statusTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#E6FFFFFF"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Ouvrir une app -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/openTikTok"
                    style="@style/GlassApp"
                    android:layout_marginEnd="6dp"
                    android:text="TikTok" />

                <TextView
                    android:id="@+id/openInsta"
                    style="@style/GlassApp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:text="Instagram" />

                <TextView
                    android:id="@+id/openX"
                    style="@style/GlassApp"
                    android:layout_marginStart="6dp"
                    android:text="X" />
            </LinearLayout>

            <!-- Mode d'emploi -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass"
                android:lineSpacingExtra="4dp"
                android:padding="22dp"
                android:text="Partager → TikSave depuis l'app,
ou copie le lien puis appuie sur Coller."
                android:textColor="#B3FFFFFF"
                android:textSize="15sp" />

            <!-- Diagnostic -->
            <LinearLayout
                android:id="@+id/diag"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass"
                android:gravity="center_vertical"
                android:paddingLeft="22dp"
                android:paddingRight="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Diagnostic"
                    android:textColor="#E6FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#80FFFFFF"
                    android:textSize="24sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:textColor="#4DFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>

    <!-- Dock -->
    <FrameLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="@drawable/bg_glass_dock"
            android:padding="8dp">

            <TextView
                android:id="@+id/pasteBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_pill"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Coller un lien"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />
        </FrameLayout>
    </FrameLayout>

    <!-- Splash -->
    <FrameLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        android:clickable="true">

        <View
            android:id="@+id/splashGlow"
            android:layout_width="420dp"
            android:layout_height="420dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_splash_glow" />

        <ImageView
            android:id="@+id/splashLogo"
            android:layout_width="250dp"
            android:layout_height="250dp"
            android:layout_gravity="center"
            android:src="@drawable/logo" />

    </FrameLayout>
</FrameLayout>
